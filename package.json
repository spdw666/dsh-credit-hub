{
  "name": "dsh-credit-hub",
  "version": "0.2.1",
  "description": "DSH 原生多平台账号、模型路由、签到任务与请求记录管理插件",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "plugin",
    "server",
    "client",
    "engine/src",
    "engine/vendor",
    "engine/package.json",
    "engine/LICENSE",
    "engine/THIRD_PARTY_NOTICES.md",
    "engine/config.example.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts",
    "engine/bundle",
    "release.json",
    "CHANGELOG.md",
    "docs/screenshots"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-native.mjs .",
    "check": "npm run build && npm test && npm run verify",
    "test:engine": "node --test engine/tests/*.test.mjs",
    "test:release": "node --test tests/node-runtime.test.mjs tests/release.test.mjs",
    "prepare:release": "node scripts/prepare-release.mjs spdw666/dsh-credit-hub",
    "sdk:install": "node scripts/install-dev-sdk.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
